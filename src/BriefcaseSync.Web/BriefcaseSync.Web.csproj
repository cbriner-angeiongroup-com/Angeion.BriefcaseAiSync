<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>briefcase-sync-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BriefcaseSync.Infrastructure/BriefcaseSync.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <Content Include="../../config/mapping.json" Link="config/mapping.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
