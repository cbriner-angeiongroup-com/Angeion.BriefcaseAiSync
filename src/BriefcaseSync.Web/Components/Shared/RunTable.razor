@if (Runs.Count == 0) { <div class="p-9 text-center"><Icon Name="clock" Class="mx-auto text-muted-foreground" /><p class="mt-3 text-sm font-medium">No sync runs yet</p><p class="mt-2 text-xs text-muted-foreground">Scheduled executions will appear here after the worker runs.</p></div> }
else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Run</th><th>Outcome</th><th>Processed</th><th>Attention</th><th>Started (UTC)</th></tr></thead><tbody>@foreach (var run in Runs) { <tr><td><span class="font-mono text-[11px]">@run.Id.ToString("N")[..8]</span><span class="ml-2 text-[10px] text-muted-foreground">@(run.DryRun ? "Dry run" : "Delivery")</span></td><td><StatusBadge Text="@run.Outcome" /></td><td>@run.Processed</td><td class="@(run.Attention + run.Failed > 0 ? "text-destructive" : "text-muted-foreground")">@(run.Attention + run.Failed)</td><td class="whitespace-nowrap font-mono text-[11px] text-muted-foreground">@run.StartedAtUtc.ToString("MMM dd, HH:mm")</td></tr> }</tbody></table></div> }
@code { [Parameter] public IReadOnlyList<RunSummary> Runs { get; set; } = []; }
