@page "/configuration"
@attribute [Authorize(Policy = "Configure")]
@inject OperationsService Service
<PageTitle>Configuration · Briefcase Sync</PageTitle>
<div class="page-header"><div><p class="eyebrow mb-2">Integration settings</p><h1>Sync configuration</h1><p class="page-description">Schedule, eligibility, document classification, and field mappings.</p></div><button class="btn-secondary" @onclick="Load" disabled="@saving"><Icon Name="refresh" />Reload settings</button></div>
<Feedback Message="@error" Error /><Feedback Message="@success" />
@if (settings == null && error == null) { <Loading /> }
else if (settings != null)
{
    <EditForm Model="settings" OnSubmit="Save" FormName="runtime-settings">
        <div class="notice mb-5"><Icon Name="lock" Class="shrink-0 text-primary" /><div><p class="font-medium">@(Service.IsDemo ? "Changes stay in this synthetic workspace" : "Settings apply to the next due worker execution")</p><p class="mt-1 text-muted-foreground">Version @version · Saved @savedAt.ToString("MMM dd, HH:mm") UTC. Secrets, tenant endpoints, and the identity scope remain managed by deployment.</p></div></div>
        <div class="grid gap-5 xl:grid-cols-2">
            <section class="panel p-6"><div class="mb-5 flex items-center gap-2"><Icon Name="clock" Class="text-primary" /><h2>Schedule &amp; eligibility</h2></div><label for="cron">Sync schedule (UTC cron)</label><InputText id="cron" class="form-input font-mono" @bind-Value="settings.ScheduleCron" /><p class="form-help">Five fields. <span class="font-mono">*/15 * * * *</span> runs every 15 minutes. Changes are checked on the next Azure worker pulse.</p><div class="mt-5"><label for="eligible-status">Eligible case status ID</label><InputNumber id="eligible-status" class="form-input" @bind-Value="settings.EligibleStatusId" min="0" /><p class="form-help">Leave 0 while the status is TBD. Delivery requires a positive approved status ID.</p></div><div class="mt-5"><label for="timeout">Run timeout (minutes)</label><InputNumber id="timeout" class="form-input" @bind-Value="settings.RunTimeoutMinutes" min="1" max="50" /><p class="form-help">Keep the worker below the Azure job's 60-minute timeout.</p></div></section>
            <section class="panel p-6"><div class="mb-5 flex items-center gap-2"><Icon Name="file" Class="text-primary" /><h2>Document delivery</h2></div><label class="flex min-h-10 items-center justify-between gap-3"><span>Include document delivery</span><InputCheckbox class="size-4 accent-primary" @bind-Value="settings.RetainersEnabled" /></label><p class="form-help">Documents must have category @DocumentClassification.Category and subcategory @DocumentClassification.Subcategory, and match both configured IDs. Preview lists candidates without downloading or uploading files.</p><div class="mt-5 grid gap-4 sm:grid-cols-2"><div><label for="category-id">OnTask category ID</label><InputNumber id="category-id" class="form-input" @bind-Value="settings.RetainerCategoryId" min="0" /></div><div><label for="subcategory-id">Submitted File subcategory ID</label><InputNumber id="subcategory-id" class="form-input" @bind-Value="settings.RetainerSubcategoryId" min="0" /></div></div><div class="notice mt-5"><Icon Name="info" Class="shrink-0" /><p>Use the tenant IDs for OnTask / Submitted File. Documents with missing or different classification names are excluded.</p></div></section>
            <section class="panel p-6"><div class="mb-5 flex items-center gap-2"><Icon Name="settings" Class="text-primary" /><h2>Source contact bindings</h2></div><div class="grid gap-4 sm:grid-cols-3"><div><label for="primary-phone">Primary phone type</label><InputText id="primary-phone" class="form-input" @bind-Value="settings.PrimaryPhoneType" /></div><div><label for="secondary-phone">Secondary type</label><InputText id="secondary-phone" class="form-input" @bind-Value="settings.SecondaryPhoneType" /></div><div><label for="emergency-phone">Emergency type</label><InputText id="emergency-phone" class="form-input" @bind-Value="settings.EmergencyPhoneType" /></div></div><p class="form-help">Exact tenant labels. Primary contact selection is explicit; the injured plaintiff is not substituted.</p><div class="mt-5"><label for="tiger-path">Tiger Lead ID UDF path</label><InputText id="tiger-path" class="form-input font-mono" @bind-Value="settings.Mapping.LeadVendorIdUdfPath" /><p class="form-help">Exact ScreenName/short-name path. This value becomes leadVendorId.</p></div></section>
            <section class="panel p-6"><div class="mb-5 flex items-center gap-2"><Icon Name="lock" Class="text-primary" /><h2>Delivery controls</h2></div><label class="flex min-h-12 items-center justify-between gap-4 border-b border-border py-2"><span><span class="block">Mapping approved</span><span class="mt-1 block text-[11px] font-normal text-muted-foreground">All field bindings and branch behavior have been reviewed.</span></span><InputCheckbox class="size-4 accent-primary" @bind-Value="settings.MappingApproved" disabled="@Service.IsLocalPreview" /></label><label class="flex min-h-12 items-center justify-between gap-4 py-3"><span><span class="block">Enable remote delivery</span><span class="mt-1 block text-[11px] font-normal text-muted-foreground">The next due run may create intakes and upload documents.</span></span><InputCheckbox class="size-4 accent-primary" @bind-Value="settings.SendingEnabled" disabled="@Service.IsLocalPreview" /></label><p class="form-help">@(Service.IsLocalPreview ? "Local development preview keeps sending and mapping approval disabled." : "Saving with delivery enabled can cause external writes on a later scheduled run. Preview never sends, regardless of this setting.")</p><div class="mt-4 rounded-lg bg-background px-4 py-3"><p class="text-[11px] text-muted-foreground">Current draft</p><div class="mt-2"><StatusBadge Text="@(settings.SendingEnabled ? "Running" : "Paused")" /></div></div></section>
        </div>
        <section class="panel mt-5 p-6" aria-labelledby="document-types-heading">
            <div class="flex flex-wrap items-center justify-between gap-3"><div><h2 id="document-types-heading">Document type mappings</h2><p class="form-help">Map each SmartAdvocate document's docType to BriefCase documentType. Initial mappings match names exactly.</p></div><button type="button" class="btn-secondary" @onclick="AddDocumentType">Add document type mapping</button></div>
            <p class="mt-3 text-xs leading-6 text-muted-foreground">Source names must match exactly. Missing or unmapped docType values block upload. Other must be selected explicitly. Document selection requires OnTask / Submitted File and both configured IDs. Saved mapping changes apply to new uploads; pending uploads keep their frozen type.</p>
            <div class="mt-5 space-y-4">
                @for (var i = 0; i < settings.DocumentTypeMappings.Count; i++)
                {
                    var row = settings.DocumentTypeMappings[i]; var number = i + 1;
                    <div @key="row" class="grid items-end gap-3 rounded-lg border border-border p-4 sm:grid-cols-[1fr_1fr_auto]">
                        <div><label for="source-document-type-@number">SmartAdvocate type @number</label><InputText id="@($"source-document-type-{number}")" class="form-input" @bind-Value="row.SourceType" maxlength="255" /></div>
                        <div><label for="briefcase-document-type-@number">BriefCase type @number</label><InputSelect id="@($"briefcase-document-type-{number}")" class="form-input" @bind-Value="row.DocumentType"><option value="">Choose a document type</option>@foreach (var type in DocumentTypes.Accepted) { <option value="@type">@type</option> }</InputSelect></div>
                        <button type="button" class="btn-secondary" aria-label="Remove document type mapping @number" @onclick="() => settings.DocumentTypeMappings.Remove(row)">Remove</button>
                    </div>
                }
            </div>
            @if (settings.DocumentTypeMappings.Count == 0) { <p class="form-help mt-4">Add at least one mapping before saving.</p> }
        </section>
        <section class="panel mt-5 p-6"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2>Field mapping profile</h2><p class="form-help">@settings.Mapping.Mappings.Count destinations · Conditional narratives, translations, and source precedence.</p></div><div class="w-full sm:w-72"><label for="mapping-version">Mapping version</label><InputText id="mapping-version" class="form-input font-mono" @bind-Value="settings.Mapping.MappingVersion" /></div></div><details class="mt-5"><summary class="min-h-10 py-2 text-xs font-medium text-primary">Edit full mapping JSON</summary><p class="form-help mb-3">Only mapping rules are editable here. This editor does not accept credentials or connection endpoints. Full JSON is validated when saving.</p><label class="sr-only" for="mapping-json">Mapping JSON</label><textarea id="mapping-json" class="form-input min-h-80 py-3 font-mono text-[11px] leading-5" @bind="mappingJson" spellcheck="false"></textarea><p class="form-help">If you edit JSON, it replaces the mapping profile. The Tiger path and version fields above are then applied.</p></details></section>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-border bg-card p-5"><p class="max-w-xl text-xs leading-6 text-muted-foreground">Review the settings before saving. Changes are versioned and audited; a running sync keeps its original configuration snapshot.</p><button class="btn-primary" type="submit" disabled="@saving"><Icon Name="@(saving ? "refresh" : "check")" Class="@(saving ? "busy" : "")" />@(saving ? "Saving…" : "Save settings")</button></div>
    </EditForm>
}
@code {
    private RuntimeSettings? settings; private int version; private DateTimeOffset savedAt; private string mappingJson = "", originalJson = ""; private string? error, success; private bool saving;
    protected override Task OnInitializedAsync() => Load();
    private void AddDocumentType() => settings?.DocumentTypeMappings.Add(new());
    private async Task Load() { error = null; success = null; try { var result = await Service.Settings(); settings = result.Settings; version = result.Version; savedAt = result.SavedAtUtc; mappingJson = originalJson = JsonSerializer.Serialize(settings.Mapping, new JsonSerializerOptions { WriteIndented = true }); } catch (UiOperationException e) { error = e.Message; } }
    private async Task Save()
    {
        if (settings == null) return; saving = true; error = null; success = null;
        try {
            if (mappingJson != originalJson) { var mapping = JsonSerializer.Deserialize<MappingOptions>(mappingJson) ?? throw new JsonException(); mapping.LeadVendorIdUdfPath = settings.Mapping.LeadVendorIdUdfPath; mapping.MappingVersion = settings.Mapping.MappingVersion; settings.Mapping = mapping; }
            var result = await Service.Save(settings, version); version = result.Version; savedAt = result.SavedAtUtc;
            mappingJson = originalJson = JsonSerializer.Serialize(settings.Mapping, new JsonSerializerOptions { WriteIndented = true });
            success = Service.IsDemo ? $"Version {version} saved in this synthetic workspace. No live settings changed." : $"Version {version} saved. The next due worker run will use these settings.";
        } catch (JsonException) { error = "The mapping JSON is invalid. Correct it before saving."; } catch (UiOperationException e) { error = e.Message; } finally { saving = false; }
    }
}
