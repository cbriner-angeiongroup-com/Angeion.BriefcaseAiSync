@page "/preview"
@attribute [Authorize(Policy = "Preview")]
@implements IDisposable
@inject OperationsService Service
@inject IJSRuntime JS
<PageTitle>Preview a case · Briefcase Sync</PageTitle>
<div class="page-header"><div><p class="eyebrow mb-2">Case preview</p><h1>Case sync preview</h1><p class="page-description">Enter a SmartAdvocate case number to inspect the proposed intake, field mappings, and documents.</p></div><span class="status status-processing"><Icon Name="eye" Class="size-3" />Preview only</span></div>
<section class="panel mb-5 p-5 sm:p-6"><form @onsubmit="Generate" @onsubmit:preventDefault class="flex flex-wrap items-end gap-3"><div class="w-full max-w-sm"><label for="case-number">SmartAdvocate case number</label><input id="case-number" class="form-input font-mono" @bind="caseNumber" placeholder="e.g. SA-10428" maxlength="100" autocomplete="off" required /></div><button class="btn-primary" type="submit" disabled="@busy"><Icon Name="@(busy ? "refresh" : "eye")" Class="@(busy ? "busy" : "")" />@(busy ? "Building preview…" : "Run preview")</button><p class="mb-2 text-[11px] text-muted-foreground">Exact case number · No records or files are sent</p></form></section>
<Feedback Message="@error" Error />
@if (busy) { <div class="panel flex min-h-60 flex-col items-center justify-center p-8 text-center" role="status"><Icon Name="refresh" Class="busy text-primary" /><h2 class="mt-4">Reading the current case</h2><p class="mt-2 text-xs text-muted-foreground">Loading contact details, UDF answers, existing delivery state, and eligible document metadata.</p></div> }
else if (plan == null) { <section class="panel grid min-h-72 place-items-center p-8 text-center"><div><span class="mx-auto grid size-12 place-items-center rounded-xl bg-accent text-primary"><Icon Name="eye" Class="size-6" /></span><h2 class="mt-5">No preview generated</h2><p class="mx-auto mt-3 max-w-md text-xs leading-6 text-muted-foreground">Enter a case number to view eligibility, mapped fields, validation issues, and eligible documents.</p>@if (Service.IsDemo) { <button class="btn-secondary mt-5" @onclick="UseExample">Use example case SA-10428<Icon Name="arrow" /></button> }</div></section> }
else
{
    <section class="panel mb-5 p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="eyebrow mb-2">Preview result · @plan.CaseNumber</p><h2 class="text-lg">@plan.Action</h2><p class="mt-2 max-w-3xl text-xs leading-6 text-muted-foreground">@plan.Explanation</p></div><StatusBadge Text="@plan.Action" /></div><div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-border pt-4 text-[11px] text-muted-foreground"><span><strong class="font-medium text-foreground">@plan.Fields.Count(f => f.Outcome == "Included")</strong> included fields</span><span><strong class="font-medium text-foreground">@plan.Fields.Count(f => f.Outcome == "Omitted")</strong> omitted</span><span><strong class="font-medium text-foreground">@plan.Errors.Count</strong> validation issues</span><span><strong class="font-medium text-foreground">@plan.Documents.Count</strong> document candidates</span><span class="ml-auto font-mono">@plan.GeneratedAtUtc.ToString("HH:mm:ss") UTC</span></div></section>
    @if (plan.Errors.Count > 0) { <div class="notice mb-5 text-destructive" role="alert"><Icon Name="alert" Class="shrink-0" /><div><p class="font-semibold">Resolve validation issues before delivery</p>@foreach (var issue in plan.Errors) { <p class="mt-2"><span class="font-mono">@issue.Field</span> · @issue.Message</p> }</div></div> }
    <div class="notice mb-5 items-center"><Icon Name="lock" Class="shrink-0 text-primary" /><div class="flex-1"><p class="font-medium">@(revealed ? "Protected values are visible for two minutes" : "Protected values are hidden")</p><p class="mt-1 text-muted-foreground">@(Service.IsDemo ? "This example contains synthetic data. Live disclosure is recorded in the access audit." : "Revealing contact details, answers and document names records your access. Values hide automatically after two minutes.")</p></div><button class="btn-secondary shrink-0" @onclick="ToggleDisclosure">@(revealed ? "Hide values" : "Reveal values")</button></div>
    <div class="mb-5 flex flex-wrap items-center gap-1 rounded-lg border border-border bg-muted/40 p-1" role="tablist" aria-label="Preview views">
        @foreach (var view in Views) { <button type="button" role="tab" id="@($"tab-{view.Id}")" aria-controls="preview-content" aria-selected="@(tab == view.Id ? "true" : "false")" class="@(tab == view.Id ? "btn-secondary border-transparent shadow-sm" : "btn-ghost")" @onkeydown="e => SwitchTab(e, view.Id)" tabindex="@(tab == view.Id ? 0 : -1)" @onclick="() => tab = view.Id">@view.Label</button> }
        <span class="ml-auto hidden px-3 font-mono text-[10px] text-muted-foreground md:inline">@plan.MappingVersion</span>
    </div>
    <div id="preview-content" role="tabpanel" aria-labelledby="@($"tab-{tab}")">
    @if (tab == "intake")
    {
        @if (!revealed) { <section class="panel flex min-h-72 flex-col items-center justify-center p-8 text-center"><Icon Name="lock" Class="size-6 text-muted-foreground" /><h2 class="mt-4">Intake values are protected</h2><p class="mt-2 max-w-sm text-xs leading-6 text-muted-foreground">Reveal values to see the proposed contact card and case summary. Field names and outcomes remain available in the mapping view.</p></section> }
        else if (plan.ProposedIntake is {} intake)
        {
            <div class="grid gap-5 xl:grid-cols-[1fr_300px]"><section class="panel overflow-hidden"><div class="flex items-center justify-between border-b border-border bg-muted/30 p-5"><div class="flex items-center gap-2"><span class="grid size-7 place-items-center rounded-md bg-secondary text-[10px] font-bold">BC</span><span class="text-xs font-semibold">BriefCase AI · Proposed intake</span></div><span class="text-[10px] text-muted-foreground">Presentation preview</span></div><div class="p-6"><p class="eyebrow">Primary contact</p><h2 class="mt-3 text-2xl">@intake.ClientFirstName @intake.ClientLastName</h2><p class="mt-2 font-mono text-[11px] text-muted-foreground">@intake.LeadVendorId</p><div class="mt-6 grid gap-5 border-t border-border pt-5 sm:grid-cols-2"><div><p class="eyebrow">Email</p><p class="mt-2 text-sm break-all">@(intake.ClientEmail ?? "Not supplied")</p></div><div><p class="eyebrow">Primary phone</p><p class="mt-2 text-sm">@(intake.ClientPhone ?? "Not supplied")</p></div><div><p class="eyebrow">Address</p><p class="mt-2 text-sm leading-6">@intake.ClientBillingStreet<br />@intake.ClientBillingCity, @intake.ClientBillingState @intake.ClientBillingPostalCode</p></div><div><p class="eyebrow">Date of birth</p><p class="mt-2 text-sm">@(intake.ClientDateOfBirth ?? "Not supplied")</p></div></div><div class="mt-6 border-t border-border pt-5"><p class="eyebrow">Case summary</p><h3 class="mt-3 text-base font-semibold">@intake.CaseType</h3><p class="mt-2 text-xs text-muted-foreground">Incident: @(intake.IncidentDate ?? "Not supplied") · @(intake.CaseState ?? "State not supplied")</p>@if (!string.IsNullOrWhiteSpace(intake.Notes)) { <p class="field-value mt-4 rounded-lg bg-background p-4">@intake.Notes</p> }@if (!string.IsNullOrWhiteSpace(intake.InjuryDescription)) { <p class="eyebrow mt-5">Injuries</p><p class="field-value mt-2">@intake.InjuryDescription</p> }</div></div></section><aside class="space-y-5"><section class="panel p-5"><h2>Sync summary</h2><dl class="mt-4 space-y-4 text-xs"><div><dt class="text-muted-foreground">Current eligibility</dt><dd class="mt-1 font-medium">@(plan.Eligible ? "Matches sync status" : "Outside sync status")</dd></div><div><dt class="text-muted-foreground">Intake action</dt><dd class="mt-1">@plan.Action</dd></div><div><dt class="text-muted-foreground">Documents</dt><dd class="mt-1">@plan.Documents.Count candidates</dd></div></dl></section><div class="notice"><Icon Name="eye" Class="shrink-0" /><p>This shows the data being handed off. BriefCase AI controls its final screen layout and defaults.</p></div></aside></div>
        }
    }
    else if (tab == "fields")
    {
        <section class="panel overflow-hidden"><div class="flex flex-wrap items-center justify-between gap-3 p-5"><h2>Field mapping · @plan.Fields.Count fields</h2><div><label class="sr-only" for="field-outcome">Filter fields</label><select class="form-input mt-0 w-40" id="field-outcome" @bind="fieldFilter"><option value="">All fields</option><option>Included</option><option>Omitted</option><option>Blocked</option></select></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>BriefCase field</th><th>SmartAdvocate source</th><th>Outcome</th><th>Proposed value</th></tr></thead><tbody>@foreach (var field in plan.Fields.Where(f => fieldFilter == "" || f.Outcome == fieldFilter)) { <tr><td class="max-w-60 break-words font-mono text-[11px]">@field.Key</td><td class="max-w-60 break-words text-[11px] text-muted-foreground">@field.Source</td><td><StatusBadge Text="@field.Outcome" /></td><td class="min-w-48 max-w-xl"><span class="field-value">@(field.Value == null ? "—" : revealed ? field.Value : "Protected value")</span>@foreach (var issue in field.Errors) { <p class="mt-2 text-[11px] text-destructive">@issue.Message</p> }</td></tr> }</tbody></table></div></section>
    }
    else if (tab == "documents")
    {
        <section class="panel overflow-hidden"><div class="p-5"><h2>Document candidates</h2><p class="mt-2 text-xs leading-6 text-muted-foreground">Only OnTask / Submitted File documents matching both configured classification IDs are listed. Preview reads metadata; content checks and uploads occur during delivery.</p></div>@if (plan.Documents.Count == 0) { <p class="border-t border-border p-8 text-center text-sm text-muted-foreground">No eligible documents were found.</p> } else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Document</th><th>Source ID</th><th>SmartAdvocate docType</th><th>BriefCase documentType</th><th>Planned action</th></tr></thead><tbody>@foreach (var document in plan.Documents) { <tr><td class="break-words">@(revealed ? document.FileName : "Protected filename")</td><td class="font-mono text-[11px]">@document.SourceDocumentId</td><td class="text-xs">@(revealed ? document.SourceType ?? "Not supplied" : "Protected type")</td><td class="text-xs">@(revealed ? document.DocumentType ?? "Not mapped" : "Protected type")</td><td class="text-xs">@document.Action</td></tr> }</tbody></table></div> }</section>
    }
    else
    {
        <section class="panel overflow-hidden"><div class="border-b border-border p-5"><h2>Outbound intake JSON</h2><p class="mt-2 text-xs text-muted-foreground">The flat request body for the proposed action. No credentials or signed upload URLs are included.</p></div>@if (revealed) { <pre class="max-h-[650px] overflow-auto p-5 font-mono text-xs leading-6">@JsonSerializer.Serialize(plan.ProposedIntake, new JsonSerializerOptions(IntakeRequest.JsonOptions) { WriteIndented = true })</pre> } else { <p class="p-8 text-center text-sm text-muted-foreground">Reveal values to inspect the outbound request.</p> }</section>
    }
    </div>
}
@code {
    private readonly (string Id, string Label)[] Views = [("intake", "Intake preview"), ("fields", "Field mapping"), ("documents", "Documents"), ("json", "Request JSON")];
    private string caseNumber = "", tab = "intake", fieldFilter = ""; private bool busy, revealed; private string? error; private SyncPreview? plan;
    private readonly CancellationTokenSource lifetime = new(); private CancellationTokenSource? disclosure;
    private async Task UseExample() { caseNumber = "SA-10428"; await Generate(); }
    private async Task SwitchTab(KeyboardEventArgs e, string id)
    {
        var current = Array.FindIndex(Views, v => v.Id == id);
        var next = e.Key switch { "ArrowRight" => (current + 1) % Views.Length, "ArrowLeft" => (current + Views.Length - 1) % Views.Length, "Home" => 0, "End" => Views.Length - 1, _ => -1 };
        if (next < 0) return; tab = Views[next].Id; await JS.InvokeVoidAsync("briefcaseTheme.focus", "tab-" + tab);
    }
    private async Task Generate() { disclosure?.Cancel(); revealed = false; plan = null; error = null; busy = true; try { plan = await Service.Preview(caseNumber, lifetime.Token); tab = "intake"; } catch (UiOperationException e) { error = e.Message; } catch (OperationCanceledException) { } finally { busy = false; } }
    private async Task ToggleDisclosure() { if (revealed) { revealed = false; disclosure?.Cancel(); return; } if (plan == null) return; try { await Service.RecordDisclosure(plan.SourceCaseId, lifetime.Token); revealed = true; disclosure?.Cancel(); disclosure = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token); _ = Expire(disclosure.Token); } catch (UiOperationException e) { error = e.Message; } }
    private async Task Expire(CancellationToken ct) { try { await Task.Delay(TimeSpan.FromMinutes(2), ct); await InvokeAsync(() => { revealed = false; StateHasChanged(); }); } catch (OperationCanceledException) { } }
    public void Dispose() { lifetime.Cancel(); disclosure?.Cancel(); disclosure?.Dispose(); lifetime.Dispose(); }
}
