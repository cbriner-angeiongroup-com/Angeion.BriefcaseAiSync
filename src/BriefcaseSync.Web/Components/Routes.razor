<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.Missing)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.WorkspaceLayout)">
            <NotAuthorized><div class="panel p-8"><h1 class="text-xl font-semibold">Access restricted</h1><p class="mt-3 text-muted-foreground">Sign in with an assigned sync role to continue.</p><a class="btn-primary mt-5" href="/auth/login">Sign in with Microsoft</a></div></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
